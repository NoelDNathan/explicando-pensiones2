# Variables de la aplicacion. Copia este archivo a `.env.local` y rellena.
#
# Todo lo de aqui viaja al navegador: Vite incrusta cualquier variable con
# prefijo VITE_ en el bundle. La anon key esta pensada para eso (es publica y
# la protege la RLS), pero NUNCA pongas aqui la service_role key: esa salta
# todas las policies y solo vive en los secretos de las Edge Functions.

# Proyecto Supabase (region UE).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endpoint de ingesta anonima del cuestionario del paso 11.
# Sin definir, los informes se encolan en el navegador y no se envia nada.
# En produccion: https://<proyecto>.supabase.co/functions/v1/knowledge-check
VITE_FEEDBACK_ENDPOINT=

# Version de la app que acompanya a cada snapshot estadistico, para que los
# agregados sean reproducibles (regla 8 de AGENTS.md).
VITE_APP_RELEASE=dev

# Rutas internas (/inicio, /componentes, /poblacion, /resumen...). En `pnpm dev`
# siempre estan activas; en produccion solo si se pone a "true".
VITE_SHOW_INTERNAL=
